rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // phone of the user: real SMS login, or test login (91XXXXXXXXXX@login.foodgaon.app, OTP 1234 phase)
    function ph() {
      return !signedIn() ? 'none'
        : request.auth.token.get('phone_number', null) != null ? request.auth.token.phone_number
        : request.auth.token.get('email', '').matches('^91[0-9]{10}@login[.]foodgaon[.]app$')
          ? '+' + request.auth.token.email.split('@')[0] : 'none';
    }
    function staff() { return get(/databases/$(database)/documents/staff/$(ph())).data; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(ph())); }
    // super admin = TechGaon (Suraj Bhan Pandey)
    function isSuper() { return ph() == '+919129203268'; }
    function isAdmin() { return isSuper() || (isStaff() && staff().get('admin', false) == true); }
    function isRider() { return isStaff() && staff().get('rider', false) == true; }
    function riderOf() { return staff().get('riderOf', ''); }
    function ownsRest(rid) { return isStaff() && staff().get('restaurant', '') == rid; }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /restaurants/{rid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (ownsRest(rid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commissionPct', 'commissionGstExtra', 'deliveryCharge', 'rating', 'sort', 'demo', 'codBlocked', 'codDue', 'verified', 'applicationId', 'onlinePay', 'rzpLinked', 'samePrice']));
    }
    match /items/{id} {
      allow read: if true;
      allow create: if isAdmin() || ownsRest(request.resource.data.restaurantId);
      allow update, delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // a restaurant may run its own offers (it pays the discount itself)
      allow create: if ownsRest(request.resource.data.restaurantId) && request.resource.data.fundedBy == 'restaurant';
      allow update: if ownsRest(resource.data.restaurantId) && request.resource.data.restaurantId == resource.data.restaurantId && request.resource.data.fundedBy == 'restaurant';
      allow delete: if ownsRest(resource.data.restaurantId);
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if ownsRest(request.resource.data.restaurantId);
      allow update, delete: if ownsRest(resource.data.restaurantId);
    }
    match /staff/{phone} {
      allow read: if phone == ph() || isAdmin();
      allow write: if isAdmin();
      // a restaurant owner can add / remove its own delivery boys (never admin or owner rights)
      allow create: if ownsRest(request.resource.data.riderOf)
                    && request.resource.data.get('admin', false) == false && request.resource.data.get('restaurant', '') == '';
      allow update: if (ownsRest(resource.data.get('riderOf', '')) || ownsRest(request.resource.data.get('riderOf', '')))
                    && request.resource.data.get('admin', false) == false && request.resource.data.get('restaurant', '') == ''
                    && resource.data.get('admin', false) == false && resource.data.get('restaurant', '') == '';
    }
    match /riders/{phone} {
      allow read: if signedIn();
      allow write: if phone == ph() || isAdmin();
    }
    match /riderPays/{id} {
      allow create: if ownsRest(request.resource.data.restaurantId) && request.resource.data.status == 'sent'
                    && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow read: if isAdmin() || ownsRest(resource.data.restaurantId) || resource.data.riderPhone == ph();
      allow update: if isAdmin() || ownsRest(resource.data.restaurantId)
                    || (resource.data.riderPhone == ph() && request.resource.data.status == 'received'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedMs']));
      allow delete: if isAdmin();
    }
    match /customers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
                    && request.resource.data.status in ['placed', 'awaiting_payment'];
      allow read: if signedIn() && (
                       resource.data.customerUid == request.auth.uid
                    || isAdmin()
                    || ownsRest(resource.data.restaurantId)
                    || (isRider() && (resource.data.riderPhone == ph()
                         || (resource.data.riderPhone == '' && resource.data.restaurantId == riderOf()))));
      allow update: if isAdmin()
                    || ownsRest(resource.data.restaurantId)
                    || (isRider() && (resource.data.riderPhone == ph()
                         || (resource.data.riderPhone == '' && resource.data.restaurantId == riderOf() && request.resource.data.riderPhone == ph())))
                    || (signedIn() && resource.data.customerUid == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeline', 'rating', 'review', 'cancelReason', 'paymentClaim', 'claimMs', 'riderRating', 'reviewTags', 'reviewMs', 'qc', 'issue', 'payment', 'upiStatus', 'upiTxn', 'upiRef', 'hide', 'proofCount'])
                         && (request.resource.data.status == resource.data.status
                             || (resource.data.status == 'placed' && request.resource.data.status == 'cancelled')
                             || (resource.data.status == 'awaiting_payment' && request.resource.data.status in ['placed', 'payment_failed'])));
      allow delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }
    match /settlements/{id} {
      allow create: if ownsRest(request.resource.data.restaurantId) && request.resource.data.status == 'claimed'
                    && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow read: if isAdmin() || ownsRest(resource.data.restaurantId);
      allow update, delete: if isAdmin();
    }
    match /reviews/{orderId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.customerUid == request.auth.uid
                    && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
                    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }
    // customer's UPI payment screenshots for an order (seen by that restaurant and the admin)
    match /payproofs/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
                    && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isAdmin() || ownsRest(resource.data.restaurantId));
      allow delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }
    // restaurant's payment screenshots for a commission payment to FoodGaon
    match /settproofs/{id} {
      allow create: if ownsRest(request.resource.data.restaurantId);
      allow read: if isAdmin() || ownsRest(resource.data.restaurantId);
      allow delete: if isAdmin();
    }
    match /riderLoc/{phone} {
      allow read: if signedIn();
      allow write: if phone == ph() || isAdmin();
    }


    // ---------- TechGaon firm app (enquiries, work orders, agreements, payments) ----------
    function myTg(p) { return p is string && '+91' + p == ph(); }
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'type', 'message', 'lang', 'source', 'status', 'createdAt'])
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new';
      allow read, update, delete: if isSuper();
    }
    match /tgConfig/{doc} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /tgOrders/{id} {
      allow read: if isSuper() || (signedIn() && myTg(resource.data.phone));
      allow create: if signedIn() && myTg(request.resource.data.phone)
        && request.resource.data.status == 'submitted' && request.resource.data.paidTotal == 0
        && !('quote' in request.resource.data) && !('agreement' in request.resource.data) && !('payClaim' in request.resource.data)
        && request.resource.data.details is string && request.resource.data.details.size() <= 3000;
      allow update: if isSuper() || (signedIn() && myTg(resource.data.phone)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'agreement', 'payClaim', 'updatedAt'])
        && ((resource.data.status == 'submitted' && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'quoted' && request.resource.data.status == 'accepted' && 'agreement' in request.resource.data)
          || (request.resource.data.status == resource.data.status && resource.data.status in ['accepted', 'inprogress', 'delivered']
              && !('agreement' in request.resource.data.diff(resource.data).affectedKeys()))));
      allow delete: if isSuper();
    }
    match /tgOrderDocs/{id} {
      allow read: if isSuper() || (signedIn() && myTg(resource.data.phone));
      allow create: if signedIn() && myTg(request.resource.data.phone) && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow update, delete: if isSuper();
    }

    // ---------- restaurant partner onboarding (application + documents) ----------
    match /partnerApps/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.ownerPhone == ph() || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.ownerPhone == ph()
                    && request.resource.data.status in ['draft', 'submitted']
                    && !request.resource.data.keys().hasAny(['restaurantId', 'approvedMs']);
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && resource.data.status in ['draft', 'submitted', 'returned']
                        && request.resource.data.ownerPhone == ph()
                        && (request.resource.data.status in ['draft', 'submitted'] || (request.resource.data.status == 'returned' && resource.data.status == 'returned'))
                        && !request.resource.data.keys().hasAny(['restaurantId', 'approvedMs']));
      allow delete: if isAdmin();
    }
    match /partnerDocs/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '__' + request.resource.data.type
                    && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                    && (!exists(/databases/$(database)/documents/partnerApps/$(request.auth.uid))
                        || get(/databases/$(database)/documents/partnerApps/$(request.auth.uid)).data.status in ['draft', 'submitted', 'returned']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // customer's photo of a wrong / bad order (seen by the admin and that restaurant)
    match /complaints/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
                    && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
                    && request.resource.data.img is string && request.resource.data.img.size() < 600000;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isAdmin() || ownsRest(resource.data.restaurantId));
      allow delete: if isAdmin();
    }
    // payment-gateway account ids of restaurants (server + admin only)
    match /restPrivate/{restId} {
      allow read, write: if isAdmin();
    }
  }
}
